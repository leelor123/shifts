rules_version = '2';

// Every user can read and write only their own data under users/{uid}.
// Anonymous statistics are readable by admins only; support requests by their writer and admins.
// The games' champions table is public to signed-in users: a nickname, an emoji and scores, by choice.
// The friends' competition: a player's card is read only by the friends they chose (and only with amounts if they show them).
// Inviting a friend: who invited whom is read only by the two of them.
// A workplace code: a workplace's rules (never a shift, an amount or a person), read by signed-in coworkers who have the code.
// Nothing else is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // records are stored as {u: updatedAt, d: deleted?, j: json}; cap each document at ~900KB
        allow create: if valid(uid, collection);
        // never replace a newer version with an older one (a phone that was offline for a while)
        allow update: if valid(uid, collection) && request.resource.data.u >= resource.data.u;
      }
    }

    // anonymous usage statistics (stats.js): a signed-in device writes its own record under a random id,
    // with a fixed shape and no personal data; only admins can read them
    match /stats/{id} {
      allow create, update: if request.auth != null && id.size() >= 16 && id.size() <= 40 && validStats(request.resource.data);
      allow delete: if request.auth != null;
      allow read: if isAdmin();
    }
    // error reports (app/errors.js): part of the usage statistics, sent only with the same yes. Written once by a signed-in
    // device under a random id, never changed; a fixed shape with no personal data (validErr); read by admins only,
    // at most 50 at a time (the dashboard's list of this week's errors)
    match /errors/{id} {
      allow create: if request.auth != null && id.matches('^[0-9a-f]{16,40}$') && validErr(request.resource.data);
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow delete: if isAdmin();
      allow update: if false;
    }
    // admins: a user may check whether they are one; only an admin can add or remove admins
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['added', 'by'])
        && request.resource.data.by == request.auth.uid && request.resource.data.added is int;
      allow delete: if isAdmin() && uid != request.auth.uid;
      allow update: if false;
    }

    // support requests (views-support.js): only the person who wrote one and the admins can read it.
    // Someone who can't sign in may still write one (with an email for the answer) but can't read anything.
    match /tickets/{tid} {
      allow create: if validTicket(request.resource.data)
        && request.resource.data.status == 'open' && request.resource.data.last == 'user' && request.resource.data.seen == true
        && ((request.auth != null && request.resource.data.uid == request.auth.uid)
          || (request.auth == null && request.resource.data.uid == '' && 'email' in request.resource.data && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')));
      allow get: if isAdmin() || ownTicket();
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // a conversation only moves forward: who wrote last, status, when, and whether the reply was seen
      allow update: if validTicket(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated', 'last', 'seen'])
        && (isAdmin() || (ownTicket()
          && (request.resource.data.status == resource.data.status || request.resource.data.status in ['open', 'closed'])
          && (request.resource.data.last == resource.data.last || request.resource.data.last == 'user')));
      // the writer may remove their own (deleting the account); an admin only one that was closed
      allow delete: if ownTicket() || (isAdmin() && resource.data.status == 'closed');

      match /msgs/{mid} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['from', 'text', 't'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.t is int
          && ((request.resource.data.from == 'user' && ticketOwner(tid) == request.auth.uid)
            || (request.resource.data.from == 'admin' && isAdmin()));
        allow read: if request.auth != null && (isAdmin() || ticketOwner(tid) == request.auth.uid);
        allow delete: if request.auth != null && (ticketOwner(tid) == request.auth.uid || (isAdmin() && ticketStatus(tid) == 'closed'));
        allow update: if false;
      }
    }

    // the games' champions table (core/leaderboard.js): a player who joined has one row, written only by them;
    // every signed-in player can read the table, at most 100 rows at a time; an admin can remove a row
    match /lb/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      // only the games a write changes are checked (the others were checked when they were written): Firestore stops a
      // rule at 1000 evaluated expressions, and checking the whole row (5 games × 5 periods and their times) went over
      // it, so every write of a player with 2 games or more was refused (2 Nov 2026). The app sends one game per write.
      allow create: if request.auth != null && request.auth.uid == uid && validLb(request.resource.data, ['coins', 'quiz', 'facts', 'pairs', 'hours']);
      allow update: if request.auth != null && request.auth.uid == uid && validLb(request.resource.data, request.resource.data.g.diff(resource.data.g).affectedKeys());
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // the friends' competition (views-friends.js): a player's card, written only by them, read only by them and by
    // the friends they list in f (both sides list each other once an invitation is accepted). Amounts (s) are left
    // out when the player hides them.
    match /fr/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.f);
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid && validFr(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // an invitation to be friends: made by its sender under a long random code that only the link carries; whoever
    // opens the link may read it and accept it once (to = their uid); the sender lists their own to see who accepted
    match /inv/{code} {
      allow create: if request.auth != null && code.size() >= 16 && code.size() <= 40
        && request.resource.data.keys().hasOnly(['from', 'n', 'e', 't', 'to'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to == ''
        && validNick(request.resource.data.n) && request.resource.data.e in ['🦊', '🐯', '🦉', '🐬', '🐺', '🦅', '🦔', '🐧', '🦜', '🐻', '🐢', '🐳', '🐼', '🦁', '🐸', '🐙', '🦄', '🐝', '⚡', '🔥', '⭐', '🚀', '🎧', '⚽']
        && request.resource.data.t is int;
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if request.auth != null && resource.data.to == '' && resource.data.from != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['to'])
        && request.resource.data.to == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // inviting a friend to Shaati (app/invite.js, core/referral.js): a member's code, refc/{code} → by (their uid; the
    // link carries only the code). A new user who came with it writes ref/{their uid} once — never changed or removed,
    // so an account is invited once — and both work out a month of Plus from it. Read only by the two of them.
    match /refc/{code} {
      allow get: if request.auth != null;
      allow list, update: if false;
      allow create: if request.auth != null && code.matches('^[a-z0-9]{10,20}$')
        && request.resource.data.keys().hasOnly(['by']) && request.resource.data.by == request.auth.uid;
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }
    match /ref/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || resource.data.by == request.auth.uid);
      allow list: if request.auth != null && resource.data.by == request.auth.uid && request.query.limit <= 50;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'c', 't']) && request.resource.data.keys().hasAll(['by', 'c', 't'])
        && request.resource.data.by is string && request.resource.data.by != uid
        && request.resource.data.c is string && request.resource.data.c.matches('^[a-z0-9]{10,20}$')
        && get(/databases/$(database)/documents/refc/$(request.resource.data.c)).data.by == request.resource.data.by
        && request.resource.data.t is int
        && request.resource.data.t > request.time.toMillis() - 172800000 && request.resource.data.t < request.time.toMillis() + 172800000;
      allow update, delete: if false;
    }

    // a workplace code (app/workplace.js, core/workplace.js): one worker shares the workplace's rules under a short
    // code, and a coworker who has the code reads them. wpc/{code} holds only the rules (no shift, no amount, no name of
    // a person, no account); who owns a code is in wpo/{code}, read only by its owner. Both are written together in one
    // batch: a code is made, changed (one version up) and deleted by its owner only; nobody can list the codes.
    match /wpc/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && code.matches('^[a-km-np-z2-9]{8}$')
        && getAfter(/databases/$(database)/documents/wpo/$(code)).data.o == request.auth.uid
        && validWp(request.resource.data) && request.resource.data.v == 1;
      allow update: if request.auth != null && wpOwner(code) == request.auth.uid
        && validWp(request.resource.data) && request.resource.data.v == resource.data.v + 1;
      allow delete: if request.auth != null && wpOwner(code) == request.auth.uid;
    }
    match /wpo/{code} {
      allow get: if request.auth != null && resource.data.o == request.auth.uid;
      allow list, update: if false;
      allow create: if request.auth != null && code.matches('^[a-km-np-z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['o']) && request.resource.data.o == request.auth.uid
        && existsAfter(/databases/$(database)/documents/wpc/$(code));
      allow delete: if request.auth != null && resource.data.o == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/wpc/$(code));
    }
    function wpOwner(code) {
      return get(/databases/$(database)/documents/wpo/$(code)).data.o;
    }
    // the record: a version, when it was written (within two days of now), and the rules (the same fields and ranges as
    // core/workplace.js FIELDS)
    function validWp(d) {
      return d.keys().hasOnly(['v', 't', 'r']) && d.keys().hasAll(['v', 't', 'r'])
        && d.v is int && d.v >= 1 && d.v <= 100000
        && d.t is int && d.t > request.time.toMillis() - 172800000 && d.t < request.time.toMillis() + 172800000
        && d.r is map && validWpRules(d.r);
    }
    function validWpRules(r) {
      return r.keys().hasOnly(['n', 'ww', 'ro', 'periodStartDay', 'payDay', 'travelPerDay', 'travelMonthlyCap', 'defaultBreakPaid', 'otLaw', 'otThreshold', 'otTier1Hours', 'otTier1Pct', 'otTier2Pct', 'restPct', 'restOt1Pct', 'restOt2Pct', 'nightEnabled', 'nightFrom', 'nightTo', 'nightType', 'nightValue', 'evePct', 'roundingMode', 'roundingUnit'])
        && (!('n' in r) || (r.n is string && r.n.size() >= 1 && r.n.size() <= 40))
        && (!('ww' in r) || r.ww in [5, 6])
        && wpInt(r, 'periodStartDay', 1, 28) && wpInt(r, 'payDay', 1, 31)
        && wpNum(r, 'travelPerDay', 0, 500) && wpNum(r, 'travelMonthlyCap', 0, 20000)
        && wpBool(r, 'defaultBreakPaid') && wpBool(r, 'otLaw')
        && wpNum(r, 'otThreshold', 1, 24) && wpNum(r, 'otTier1Hours', 0, 24) && wpNum(r, 'otTier1Pct', 100, 400) && wpNum(r, 'otTier2Pct', 100, 400)
        && wpNum(r, 'restPct', 100, 500) && wpNum(r, 'restOt1Pct', 100, 500) && wpNum(r, 'restOt2Pct', 100, 500)
        && wpBool(r, 'nightEnabled') && wpHm(r, 'nightFrom') && wpHm(r, 'nightTo')
        && (!('nightType' in r) || r.nightType in ['pct', 'fixed']) && wpNum(r, 'nightValue', 0, 500)
        && wpNum(r, 'evePct', 0, 200)
        && (!('roundingMode' in r) || r.roundingMode in ['none', 'nearest', 'up', 'down']) && wpInt(r, 'roundingUnit', 1, 60)
        && (!('ro' in r) || (r.ro is list && r.ro.size() <= 8
          && wpRole(r.ro, 0) && wpRole(r.ro, 1) && wpRole(r.ro, 2) && wpRole(r.ro, 3)
          && wpRole(r.ro, 4) && wpRole(r.ro, 5) && wpRole(r.ro, 6) && wpRole(r.ro, 7)));
    }
    function wpInt(r, k, lo, hi) {
      return !(k in r) || (r[k] is int && r[k] >= lo && r[k] <= hi);
    }
    function wpNum(r, k, lo, hi) {
      return !(k in r) || (r[k] is number && r[k] >= lo && r[k] <= hi);
    }
    function wpBool(r, k) {
      return !(k in r) || r[k] is bool;
    }
    function wpHm(r, k) {
      return !(k in r) || (r[k] is string && r[k].matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    // a role: its name, and its hourly rate only when the sharer chose to include rates
    function wpRole(l, i) {
      return l.size() <= i || (l[i] is map && l[i].keys().hasOnly(['n', 'r']) && l[i].keys().hasAll(['n'])
        && l[i].n is string && l[i].n.size() >= 1 && l[i].n.size() <= 40
        && (!('r' in l[i]) || (l[i].r is number && l[i].r > 0 && l[i].r < 1000)));
    }

    // a name in any of the app's languages (Hebrew, Latin with accents, Cyrillic, Arabic), digits, an apostrophe
    // a name that looks like the app's own team is the client's rule (leaderboard.js STAFF) and the server's too:
    // a write straight to the database once put "Shaati Support" on the public table (security scan, 1 Nov 2026)
    // checked as read, not as typed (the rules' lower() leaves Cyrillic capitals as they are, so both cases are listed): without the separators, and with the letters and digits that look like Latin ones
    // read as those ("Sha.ati Supp.ort", "ЅНААТІ" in Cyrillic and "5upp0rt" passed; security scan, 2 Nov 2026)
    function foldNick(n) {
      return n.lower().replace("[ _.'׳-]", '').replace('[ѕЅ5]', 's').replace('[һнҺН]', 'h').replace('[аА4]', 'a').replace('[тТ7]', 't')
        .replace('[іІl1]', 'i').replace('[рР]', 'p').replace('[оО0]', 'o').replace('[еЕ3]', 'e').replace('[сС]', 'c').replace('[уУ]', 'y')
        .replace('[кК]', 'k').replace('[мМ]', 'm').replace('[хХ]', 'x').replace('[вВ]', 'b').replace('[јЈ]', 'j');
    }
    function notStaff(n) {
      return !foldNick(n).matches('.*(admin|moderator|support|shaati|מנהל|צוות|תמיכה|שעתי|רשמי).*');
    }
    // the letters of one language in a name (Hebrew, Latin, Cyrillic or Arabic), so a name cannot borrow look-alikes
    function validNick(n) {
      return n is string && n.matches("^[א-תa-zA-ZÀ-ÖØ-öø-ÿЀ-ӿ؀-ۿ0-9 _.'׳-]{2,16}$") && !n.matches('.*[0-9]{5,}.*')
        && (n.matches("^[א-ת0-9 _.'׳-]+$") || n.matches("^[a-zA-ZÀ-ÖØ-öø-ÿ0-9 _.'׳-]+$") || n.matches("^[Ѐ-ӿ0-9 _.'׳-]+$") || n.matches("^[؀-ۿ0-9 _.'׳-]+$"))
        && notStaff(n);
    }
    function validFr(d) {
      return d.keys().hasOnly(['n', 'e', 't', 'hide', 'f', 's']) && d.keys().hasAll(['n', 'e', 't', 'hide', 'f'])
        && validNick(d.n) && d.e in ['🦊', '🐯', '🦉', '🐬', '🐺', '🦅', '🦔', '🐧', '🦜', '🐻', '🐢', '🐳', '🐼', '🦁', '🐸', '🐙', '🦄', '🐝', '⚡', '🔥', '⭐', '🚀', '🎧', '⚽']
        && d.t is int && d.hide is bool
        && d.f is list && d.f.size() <= 50
        && (!('s' in d) || (d.hide == false && frStats(d.s)));
    }
    // this month's and this year's gross (with their month and year, so an old one never counts), all time, per hour
    function frStats(s) {
      return s is map && s.keys().hasOnly(['m', 'y', 'a', 'h']) && s.keys().hasAll(['m', 'y', 'a', 'h'])
        && s.m is map && s.m.keys().hasOnly(['k', 'v']) && s.m.k is int && s.m.k >= 202601 && s.m.k < 210001 && s.m.v is int && s.m.v >= 0 && s.m.v <= 10000000
        && s.y is map && s.y.keys().hasOnly(['k', 'v']) && s.y.k is int && s.y.k >= 2026 && s.y.k < 2100 && s.y.v is int && s.y.v >= 0 && s.y.v <= 100000000
        && s.a is int && s.a >= 0 && s.a <= 1000000000
        && (s.h is int || s.h is float) && s.h >= 0 && s.h <= 2000;
    }

    function ownTicket() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }
    function ticketOwner(tid) {
      return get(/databases/$(database)/documents/tickets/$(tid)).data.uid;
    }
    function ticketStatus(tid) {
      return get(/databases/$(database)/documents/tickets/$(tid)).data.status;
    }
    function validTicket(d) {
      return d.keys().hasOnly(['uid', 'reason', 'text', 'status', 'created', 'updated', 'last', 'seen', 'email', 'name', 'v', 'p', 'dev'])
        && d.keys().hasAll(['uid', 'reason', 'text', 'status', 'created', 'updated', 'last', 'seen'])
        && d.uid is string && d.uid.size() <= 40
        && d.reason in ['login', 'calc', 'payslip', 'rights', 'how', 'bug', 'data', 'notif', 'idea', 'privacy', 'other']
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 2000
        && d.status in ['open', 'answered', 'closed']
        && d.created is int && d.updated is int
        && d.last in ['user', 'admin'] && d.seen is bool
        && (!('email' in d) || (d.email is string && d.email.size() <= 100))
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('v' in d) || (d.v is string && d.v.size() <= 20))
        && (!('p' in d) || d.p in ['android', 'pwa', 'web'])
        && (!('dev' in d) || (d.dev is string && d.dev.size() <= 200));
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validStats(d) {
      return d.keys().hasOnly(['v', 'p', 'first', 'last', 'days', 'sh', 's30', 'ps', 'age', 'f', 't'])
        && d.v is string && d.v.size() <= 20
        && d.p in ['android', 'pwa', 'web']
        && d.first is string && d.first.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.last is string && d.last.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.days is int && d.days >= 0 && d.days < 100000
        && d.sh is int && d.sh >= 0 && d.sh < 1000000
        && d.s30 is int && d.s30 >= 0 && d.s30 < 100000
        && d.ps is int && d.ps >= 0 && d.ps < 100000
        && d.age in ['u18', '18p', '']
        && d.f is map && d.f.size() <= 20
        && d.t is int;
    }

    function validErr(d) {
      return d.keys().hasOnly(['v', 'l', 'os', 'br', 'tab', 'k', 'msg', 'st', 'h', 'n', 't'])
        && d.keys().hasAll(['v', 'l', 'os', 'br', 'tab', 'k', 'msg', 'st', 'h', 'n', 't'])
        && d.v is string && d.v.size() <= 20
        && d.l in ['he', 'en', 'ru', 'ar', 'fr', 'es', 'am']
        && d.os is string && d.os.size() >= 1 && d.os.size() <= 24
        && d.br is string && d.br.size() >= 1 && d.br.size() <= 32
        && d.tab is string && d.tab.matches('^[a-z_]{0,24}$')
        && d.k in ['error', 'promise', 'render', 'mount']
        && d.msg is string && d.msg.size() >= 1 && d.msg.size() <= 200
        && d.st is string && d.st.size() <= 600
        && d.h is string && d.h.matches('^[0-9a-f]{8}$')
        && d.n is int && d.n >= 1 && d.n <= 1000
        && d.t is int && d.t > request.time.toMillis() - 86400000 && d.t < request.time.toMillis() + 86400000;
    }

    function validLb(d, ch) {
      return d.keys().hasOnly(['n', 'e', 'bg', 'p', 't', 'g']) && d.keys().hasAll(['n', 'e', 't', 'g'])
        && validNick(d.n)
        && d.e in ['🦊', '🐯', '🦉', '🐬', '🐺', '🦅', '🦔', '🐧', '🦜', '🐻', '🐢', '🐳', '🐼', '🦁', '🐸', '🐙', '🦄', '🐝', '⚡', '🔥', '⭐', '🚀', '🎧', '⚽']
        && (!('bg' in d) || d.bg in ['', 'gold', 'midnight', 'sunset', 'ocean', 'forest', 'carbon', 'royal', 'rose', 'lava', 'neon', 'ice', 'galaxy'])
        && (!('p' in d) || d.p is bool)
        && d.t is int
        && d.g is map && d.g.keys().hasOnly(['coins', 'quiz', 'facts', 'pairs', 'hours'])
        && (!('coins' in ch) || lbGame(d.g, 'coins', 5000)) && (!('quiz' in ch) || lbGame(d.g, 'quiz', 3000))
        && (!('facts' in ch) || lbGame(d.g, 'facts', 10)) && (!('pairs' in ch) || lbGame(d.g, 'pairs', 140))
        && (!('hours' in ch) || lbGame(d.g, 'hours', 500));
    }
    // a game's best per period: day, week (its Sunday), month and year as period × 100000 + score; all time as the score
    // (get() with a default that passes stands for a period not stored: cheaper than 'in' and a second look)
    function lbGame(g, id, max) {
      return !(id in g) || (g[id] is map && g[id].keys().hasOnly(['d', 'w', 'm', 'y', 'a', 't'])
        && lbV(g[id].get('d', 2026010100000), 2026010100000, 2100010100000, max)
        && lbV(g[id].get('w', 2025122800000), 2025122800000, 2100010100000, max)
        && lbV(g[id].get('m', 20260100000), 20260100000, 21000100000, max)
        && lbV(g[id].get('y', 202600000), 202600000, 210000000, max)
        && lbN(g[id].get('a', 0), 0, max)
        && (!('t' in g[id]) || lbT(g[id].t)));
    }
    // when each period's best was set (ms since 1970): 2026 to 2100
    function lbT(t) {
      return t is map && t.keys().hasOnly(['d', 'w', 'm', 'y', 'a'])
        && lbN(t.get('d', 1760000000001), 1760000000001, 4099999999999) && lbN(t.get('w', 1760000000001), 1760000000001, 4099999999999)
        && lbN(t.get('m', 1760000000001), 1760000000001, 4099999999999) && lbN(t.get('y', 1760000000001), 1760000000001, 4099999999999)
        && lbN(t.get('a', 1760000000001), 1760000000001, 4099999999999);
    }
    function lbV(v, lo, hi, max) {
      return v is int && v >= lo && v < hi && v % 100000 <= max;
    }
    function lbN(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function valid(uid, collection) {
      return request.auth != null && request.auth.uid == uid
        && collection in ['employers', 'roles', 'shifts', 'entries', 'templates', 'dayRules', 'payslips', 'gaps', 'kv']
        && request.resource.data.keys().hasOnly(['u', 'd', 'j'])
        && request.resource.data.u is number
        && (request.resource.data.j == null || request.resource.data.j.size() < 900000);
    }
  }
}
