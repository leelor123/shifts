rules_version = '2';

// Every user can read and write only their own data under users/{uid}.
// Anonymous statistics are readable by admins only; support requests by their writer and admins.
// The games' champions table is public to signed-in users: a nickname, an emoji and scores, by choice.
// Nothing else is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        // records are stored as {u: updatedAt, d: deleted?, j: json}; cap each document at ~900KB
        allow create: if valid(uid, collection);
        // never replace a newer version with an older one (a phone that was offline for a while)
        allow update: if valid(uid, collection) && request.resource.data.u >= resource.data.u;
      }
    }

    // anonymous usage statistics (stats.js): a signed-in device writes its own record under a random id,
    // with a fixed shape and no personal data; only admins can read them
    match /stats/{id} {
      allow create, update: if request.auth != null && id.size() >= 16 && id.size() <= 40 && validStats(request.resource.data);
      allow delete: if request.auth != null;
      allow read: if isAdmin();
    }
    // admins: a user may check whether they are one; only an admin can add or remove admins
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['added', 'by'])
        && request.resource.data.by == request.auth.uid && request.resource.data.added is int;
      allow delete: if isAdmin() && uid != request.auth.uid;
      allow update: if false;
    }

    // support requests (views-support.js): only the person who wrote one and the admins can read it.
    // Someone who can't sign in may still write one (with an email for the answer) but can't read anything.
    match /tickets/{tid} {
      allow create: if validTicket(request.resource.data)
        && request.resource.data.status == 'open' && request.resource.data.last == 'user' && request.resource.data.seen == true
        && ((request.auth != null && request.resource.data.uid == request.auth.uid)
          || (request.auth == null && request.resource.data.uid == '' && 'email' in request.resource.data && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')));
      allow get: if isAdmin() || ownTicket();
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      // a conversation only moves forward: who wrote last, status, when, and whether the reply was seen
      allow update: if validTicket(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated', 'last', 'seen'])
        && (isAdmin() || (ownTicket()
          && (request.resource.data.status == resource.data.status || request.resource.data.status in ['open', 'closed'])
          && (request.resource.data.last == resource.data.last || request.resource.data.last == 'user')));
      // the writer may remove their own (deleting the account); an admin only one that was closed
      allow delete: if ownTicket() || (isAdmin() && resource.data.status == 'closed');

      match /msgs/{mid} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['from', 'text', 't'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.t is int
          && ((request.resource.data.from == 'user' && ticketOwner(tid) == request.auth.uid)
            || (request.resource.data.from == 'admin' && isAdmin()));
        allow read: if request.auth != null && (isAdmin() || ticketOwner(tid) == request.auth.uid);
        allow delete: if request.auth != null && (ticketOwner(tid) == request.auth.uid || (isAdmin() && ticketStatus(tid) == 'closed'));
        allow update: if false;
      }
    }

    // the games' champions table (core/leaderboard.js): a player who joined has one row, written only by them;
    // every signed-in player can read the table, at most 100 rows at a time; an admin can remove a row
    match /lb/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create, update: if request.auth != null && request.auth.uid == uid && validLb(request.resource.data);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    function ownTicket() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }
    function ticketOwner(tid) {
      return get(/databases/$(database)/documents/tickets/$(tid)).data.uid;
    }
    function ticketStatus(tid) {
      return get(/databases/$(database)/documents/tickets/$(tid)).data.status;
    }
    function validTicket(d) {
      return d.keys().hasOnly(['uid', 'reason', 'text', 'status', 'created', 'updated', 'last', 'seen', 'email', 'name', 'v', 'p', 'dev'])
        && d.keys().hasAll(['uid', 'reason', 'text', 'status', 'created', 'updated', 'last', 'seen'])
        && d.uid is string && d.uid.size() <= 40
        && d.reason in ['login', 'calc', 'payslip', 'rights', 'how', 'bug', 'data', 'notif', 'idea', 'privacy', 'other']
        && d.text is string && d.text.size() >= 10 && d.text.size() <= 2000
        && d.status in ['open', 'answered', 'closed']
        && d.created is int && d.updated is int
        && d.last in ['user', 'admin'] && d.seen is bool
        && (!('email' in d) || (d.email is string && d.email.size() <= 100))
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('v' in d) || (d.v is string && d.v.size() <= 20))
        && (!('p' in d) || d.p in ['android', 'pwa', 'web'])
        && (!('dev' in d) || (d.dev is string && d.dev.size() <= 200));
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validStats(d) {
      return d.keys().hasOnly(['v', 'p', 'first', 'last', 'days', 'sh', 's30', 'ps', 'age', 'f', 't'])
        && d.v is string && d.v.size() <= 20
        && d.p in ['android', 'pwa', 'web']
        && d.first is string && d.first.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.last is string && d.last.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.days is int && d.days >= 0 && d.days < 100000
        && d.sh is int && d.sh >= 0 && d.sh < 1000000
        && d.s30 is int && d.s30 >= 0 && d.s30 < 100000
        && d.ps is int && d.ps >= 0 && d.ps < 100000
        && d.age in ['u18', '18p', '']
        && d.f is map && d.f.size() <= 16
        && d.t is int;
    }

    function validLb(d) {
      return d.keys().hasOnly(['n', 'e', 'bg', 'p', 't', 'g']) && d.keys().hasAll(['n', 'e', 't', 'g'])
        && d.n is string && d.n.matches('^[א-תa-zA-Z0-9 _.-]{2,16}$') && !d.n.matches('.*[0-9]{5,}.*')
        && d.e in ['🦊', '🐯', '🦉', '🐬', '🐺', '🦅', '🦔', '🐧', '🦜', '🐻', '🐢', '🐳', '🐼', '🦁', '🐸', '🐙', '🦄', '🐝', '⚡', '🔥', '⭐', '🚀', '🎧', '⚽']
        && (!('bg' in d) || d.bg in ['', 'gold', 'midnight', 'sunset', 'ocean', 'forest', 'carbon', 'royal', 'rose', 'lava', 'neon', 'ice', 'galaxy'])
        && (!('p' in d) || d.p is bool)
        && d.t is int
        && d.g is map && d.g.keys().hasOnly(['coins', 'quiz', 'facts', 'pairs', 'hours'])
        && lbGame(d.g, 'coins', 5000) && lbGame(d.g, 'quiz', 3000) && lbGame(d.g, 'facts', 10)
        && lbGame(d.g, 'pairs', 140) && lbGame(d.g, 'hours', 500);
    }
    // a game's best per period: day, week (its Sunday), month and year as period × 100000 + score; all time as the score
    function lbGame(g, id, max) {
      return !(id in g) || (g[id] is map && g[id].keys().hasOnly(['d', 'w', 'm', 'y', 'a'])
        && lbVal(g[id], 'd', 20260101, 21000101, max) && lbVal(g[id], 'w', 20251228, 21000101, max)
        && lbVal(g[id], 'm', 202601, 210001, max) && lbVal(g[id], 'y', 2026, 2100, max)
        && (!('a' in g[id]) || (g[id].a is int && g[id].a >= 0 && g[id].a <= max)));
    }
    function lbVal(m, k, lo, hi, max) {
      return !(k in m) || (m[k] is int && m[k] >= lo * 100000 && m[k] < hi * 100000 && m[k] % 100000 <= max);
    }

    function valid(uid, collection) {
      return request.auth != null && request.auth.uid == uid
        && collection in ['employers', 'roles', 'shifts', 'entries', 'templates', 'dayRules', 'payslips', 'gaps', 'kv']
        && request.resource.data.keys().hasOnly(['u', 'd', 'j'])
        && request.resource.data.u is number
        && (request.resource.data.j == null || request.resource.data.j.size() < 900000);
    }
  }
}
