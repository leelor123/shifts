<?xml version="1.0" encoding="utf-8"?>
<!-- Shaati (Android 11 and older): the widgets' pay snapshot stays out of the phone's backup; the app sends a new one
     when it opens -->
<full-backup-content>
    <exclude domain="sharedpref" path="shaati_widgets.xml" />
    <!-- the workplace spot (WorkGeo) never leaves the phone, not even in a backup -->
    <exclude domain="sharedpref" path="shaati_geo.xml" />
</full-backup-content>
