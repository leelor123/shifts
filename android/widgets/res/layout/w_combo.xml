<?xml version="1.0" encoding="utf-8"?>
<!-- Shaati widget (android/widgets; copied into the Android project by tools/android.js). Colours: WidgetLook. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:clipToOutline="true" android:background="@drawable/w_bg_m">
    <ProgressBar android:id="@+id/w_scene_sea" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_scene_sea_combo_live" android:minWidth="8dp" android:minHeight="8dp" android:importantForAccessibility="no" android:maxWidth="2000dp" android:maxHeight="2000dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_scene_rain" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_scene_rain_combo_live" android:minWidth="8dp" android:minHeight="8dp" android:importantForAccessibility="no" android:maxWidth="2000dp" android:maxHeight="2000dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/w_chip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_chip_m" android:padding="6dp">
            <FrameLayout android:id="@+id/w_go" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/w_go" android:contentDescription="התחל משמרת">
            <ImageView android:id="@+id/w_go_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/w_ic_play" android:tint="@color/w_on_go" android:importantForAccessibility="no" />
        </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="התחל משמרת" android:textColor="@color/w_m_text" android:textSize="17sp" android:fontFamily="@font/w_rubik_medium" />
                <Chronometer android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_m_text" android:textSize="22sp" android:fontFamily="@font/w_rubik_medium" android:visibility="gone" />
                <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="החודש ₪2,840" android:textColor="@color/w_m_sub" android:textSize="13sp" />
            </LinearLayout>
            <FrameLayout android:id="@+id/w_play" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/w_go" android:contentDescription="התחל משמרת" android:layout_marginStart="8dp" android:visibility="gone">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/w_ic_play" android:tint="@color/w_on_go" android:importantForAccessibility="no" />
        </FrameLayout>
            <TextView android:id="@+id/w_stop" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/w_stop" android:singleLine="true" android:text="סיום" android:textColor="@color/w_on_stop" android:textSize="15sp" android:fontFamily="@font/w_rubik_medium" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="החודש עד עכשיו" android:textColor="@color/w_m_label" android:textSize="14sp" android:fontFamily="@font/w_rubik_medium" />
            <FrameLayout android:id="@+id/w_clock_box" android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/w_dot_m" android:layout_marginStart="6dp">
            <ProgressBar android:id="@+id/w_dial" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_dial_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" />
        </FrameLayout>
            <FrameLayout android:id="@+id/w_coin" android:layout_width="32dp" android:layout_height="34dp" android:layout_marginStart="6dp" android:visibility="gone">
            <ProgressBar android:id="@+id/w_face_happy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_happy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_wow" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_wow_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_cool" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_cool_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_party" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_party_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_sleepy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_sleepy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        </LinearLayout>
        <TextView android:id="@+id/w_amount" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:maxLines="1" android:text="₪2,840" android:textColor="@color/w_m_text" android:fontFamily="@font/w_rubik_medium" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="72sp" android:autoSizeStepGranularity="1sp" android:textDirection="rtl" />
        <TextView android:id="@+id/w_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="נטו ₪2,310 · 41 שעות" android:textColor="@color/w_m_sub" android:textSize="13sp" />
        <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" android:progress="64" android:progressDrawable="@drawable/w_progress" android:layoutDirection="rtl" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_goal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="64% מיעד ₪4,400" android:textColor="@color/w_m_sub" android:textSize="12sp" />
            <TextView android:id="@+id/w_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="עוד 9 ימים למשכורת" android:textColor="@color/w_m_label" android:textSize="12sp" android:fontFamily="@font/w_rubik_medium" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
