<?xml version="1.0" encoding="utf-8"?>
<!-- Shaati widget (android/widgets; copied into the Android project by tools/android.js). Colours: WidgetLook. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:clipToOutline="true" android:background="@drawable/w_bg_m" android:padding="12dp">
    <ProgressBar android:id="@+id/w_dial" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="end|bottom" android:layout_marginEnd="-40dp" android:layout_marginBottom="-44dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_dial_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:alpha="0.3" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/w_chip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/w_chip_m" android:padding="8dp">
            <FrameLayout android:id="@+id/w_go" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/w_go" android:contentDescription="התחל משמרת">
                <ImageView android:id="@+id/w_go_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/w_ic_play" android:tint="@color/w_on_go" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="התחל משמרת" android:textColor="@color/w_m_text" android:textSize="16sp" android:fontFamily="@font/w_rubik_medium" />
                <Chronometer android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_m_text" android:textSize="20sp" android:fontFamily="@font/w_rubik_medium" android:visibility="gone" />
                <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:textColor="@color/w_m_sub" android:textSize="12sp" />
            </LinearLayout>
            <FrameLayout android:id="@+id/w_play" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:background="@drawable/w_go" android:contentDescription="התחל משמרת" android:visibility="gone">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/w_ic_play" android:tint="@color/w_on_go" android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView android:id="@+id/w_stop" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/w_stop" android:singleLine="true" android:text="סיום" android:textColor="@color/w_on_stop" android:textSize="14sp" android:fontFamily="@font/w_rubik_medium" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="2dp">
            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="החודש שלי" android:textColor="@color/w_m_label" android:textSize="12sp" android:fontFamily="@font/w_rubik_medium" />
            <TextView android:id="@+id/w_amount" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical|start" android:singleLine="true" android:text="₪—" android:textColor="@color/w_m_text" android:fontFamily="@font/w_rubik_medium" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="34sp" android:textDirection="rtl" />
            <TextView android:id="@+id/w_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:textColor="@color/w_m_sub" android:textSize="12sp" />
            <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/w_progress" android:layoutDirection="rtl" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/w_goal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:singleLine="true" android:ellipsize="end" android:textColor="@color/w_m_sub" android:textSize="11sp" android:textDirection="rtl" />
                <TextView android:id="@+id/w_pay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:textColor="@color/w_m_label" android:textSize="11sp" android:fontFamily="@font/w_rubik_medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/w_coin" android:layout_width="58dp" android:layout_height="62dp" android:layout_gravity="bottom|end" android:layout_marginBottom="-6dp" android:visibility="gone">
            <ProgressBar android:id="@+id/w_face_happy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_happy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_wow" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_wow_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_cool" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_cool_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_party" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_party_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_sleepy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_sleepy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
</FrameLayout>
