<?xml version="1.0" encoding="utf-8"?>
<!-- Shaati widget (android/widgets; copied into the Android project by tools/android.js). Colours: WidgetLook. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:clipToOutline="true" android:background="@drawable/w_bg_m">
    <ProgressBar android:id="@+id/w_scene_sea" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_scene_sea_row_live" android:minWidth="8dp" android:minHeight="8dp" android:importantForAccessibility="no" android:maxWidth="2000dp" android:maxHeight="2000dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_scene_rain" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_scene_rain_row_live" android:minWidth="8dp" android:minHeight="8dp" android:importantForAccessibility="no" android:maxWidth="2000dp" android:maxHeight="2000dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/w_coin" android:layout_width="52dp" android:layout_height="56dp" android:visibility="gone">
            <ProgressBar android:id="@+id/w_face_happy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_happy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_wow" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_wow_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_cool" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_cool_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_party" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_party_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_sleepy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_sleepy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_go" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/w_go" android:contentDescription="התחל משמרת">
            <ImageView android:id="@+id/w_go_icon" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/w_ic_play" android:tint="@color/w_on_go" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="26dp" android:maxLines="1" android:textDirection="rtl" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="19sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical|start" android:text="התחל משמרת" android:textColor="@color/w_m_text" android:fontFamily="@font/w_rubik_medium" />
            <Chronometer android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_m_text" android:textSize="26sp" android:fontFamily="@font/w_rubik_medium" android:visibility="gone" />
            <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="החודש ₪2,840" android:textColor="@color/w_m_sub" android:textSize="14sp" />
        </LinearLayout>
        <FrameLayout android:id="@+id/w_play" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/w_go" android:contentDescription="התחל משמרת" android:layout_marginStart="8dp" android:visibility="gone">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/w_ic_play" android:tint="@color/w_on_go" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView android:id="@+id/w_stop" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/w_stop" android:singleLine="true" android:text="סיום" android:textColor="@color/w_on_stop" android:textSize="16sp" android:fontFamily="@font/w_rubik_medium" android:visibility="gone" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
