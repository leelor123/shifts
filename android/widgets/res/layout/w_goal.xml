<?xml version="1.0" encoding="utf-8"?>
<!-- Shaati widget (android/widgets; copied into the Android project by tools/android.js). Colours: WidgetLook. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:clipToOutline="true" android:background="@drawable/w_bg_m">
    <ProgressBar android:id="@+id/w_scene_sea" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_scene_sea_rowplain_live" android:minWidth="8dp" android:minHeight="8dp" android:importantForAccessibility="no" android:maxWidth="2000dp" android:maxHeight="2000dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_scene_rain" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="false" android:indeterminateDrawable="@drawable/w_scene_rain_rowplain_live" android:minWidth="8dp" android:minHeight="8dp" android:importantForAccessibility="no" android:maxWidth="2000dp" android:maxHeight="2000dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:id="@+id/w_icon_box" android:layout_width="30dp" android:layout_height="30dp" android:background="@drawable/w_dot_m">
                <ImageView android:id="@+id/w_icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/w_ic_target" android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout android:id="@+id/w_coin" android:layout_width="28dp" android:layout_height="30dp" android:visibility="gone">
            <ProgressBar android:id="@+id/w_face_happy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_happy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_wow" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_wow_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_cool" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_cool_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_party" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_party_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_sleepy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_sleepy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
            <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="יעד ₪4,400" android:textColor="@color/w_m_text" android:textSize="16sp" android:fontFamily="@font/w_rubik_medium" />
            <TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:singleLine="true" android:textDirection="rtl" android:text="64%" android:textColor="@color/w_m_label" android:textSize="16sp" android:fontFamily="@font/w_rubik_medium" />
        </LinearLayout>
        <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:max="100" android:progress="64" android:progressDrawable="@drawable/w_progress" android:layoutDirection="rtl" />
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="עוד ₪1,560 ליעד" android:textColor="@color/w_m_sub" android:textSize="13sp" />
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
