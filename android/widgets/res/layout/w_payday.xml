    android:background="@drawable/w_bg" android:padding="12dp">
    <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:background="@drawable/w_chip" android:text="💸" android:textSize="20sp" android:importantForAccessibility="no" />
