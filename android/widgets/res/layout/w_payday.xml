        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="המשכורת הבאה" android:textColor="@color/w_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:textColor="@color/w_gold" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
