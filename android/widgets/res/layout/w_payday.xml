<?xml version="1.0" encoding="utf-8"?>
<!-- Shaati widget (android/widgets; copied into the Android project by tools/android.js). Colours: WidgetLook. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:clipToOutline="true" android:background="@drawable/w_bg_m" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/w_clock_box" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/w_dot_m">
            <ProgressBar android:id="@+id/w_dial" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_dial_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout android:id="@+id/w_coin" android:layout_width="52dp" android:layout_height="56dp" android:visibility="gone">
            <ProgressBar android:id="@+id/w_face_happy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_happy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_wow" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_wow_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_cool" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_cool_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_party" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_party_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
            <ProgressBar android:id="@+id/w_face_sleepy" android:layout_width="match_parent" android:layout_height="match_parent" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/w_coin_sleepy_live" android:minWidth="8dp" android:minHeight="8dp" android:maxWidth="240dp" android:maxHeight="240dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="עוד 9 ימים למשכורת" android:textColor="@color/w_m_text" android:textSize="19sp" android:fontFamily="@font/w_rubik_medium" />
            <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end" android:textDirection="rtl" android:text="כ-₪2,310 נטו" android:textColor="@color/w_m_label" android:textSize="15sp" android:fontFamily="@font/w_rubik_medium" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
