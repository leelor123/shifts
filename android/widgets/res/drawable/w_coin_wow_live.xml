<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/w_coin_wow">
    <target android:name="lift">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY" android:valueFrom="6" android:valueTo="1" android:duration="1600"
                android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="4200" android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleY">
                    <keyframe android:fraction="0" android:value="1" />
                    <keyframe android:fraction="0.93" android:value="1" />
                    <keyframe android:fraction="0.96" android:value="0.1" />
                    <keyframe android:fraction="1" android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
