<?xml version="1.0" encoding="utf-8"?>
<!-- Below Android 12 these two colours stay; from 12 each look tints them (WidgetLook.bar). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#59808080" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle"><corners android:radius="3dp" /><solid android:color="#E8A33D" /></shape>
        </clip>
    </item>
</layer-list>
