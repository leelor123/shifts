<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/w_track" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle"><corners android:radius="4dp" /><solid android:color="@color/w_gold" /></shape>
        </clip>
    </item>
</layer-list>
